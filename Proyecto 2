#include <iostream>
#include <fstream>
#include <cstring>
using namespace std;

const char archivoNombre[] = "productos.dat";

struct Producto {
    int codigo;
    char nombre[31];
    float precio;
    int stock;
    char categoria[31];
    bool activo;
};

void limpiarBuffer() {
    cin.clear();
    cin.ignore(10000, '\n');
}

long buscarProducto(int codigo) {
    ifstream archivo(archivoNombre, ios::binary);
    if (!archivo) return -1;

    Producto p;
    long pos = 0;
    while (archivo.read((char*)&p, sizeof(Producto))) {
        if (p.codigo == codigo) {
            archivo.close();
            return pos;
        }
        pos++;
    }
    archivo.close();
    return -1;
}

void mostrarProducto(Producto p) {
    if (!p.activo) return;
    cout << "Codigo: " << p.codigo << "\nNombre: " << p.nombre
         << "\nPrecio: " << p.precio << "\nStock: " << p.stock
         << "\nCategoría: " << p.categoria << "\n\n";
}

void agregarProducto() {
    Producto p;
    cout << "Codigo: ";
    cin >> p.codigo;
    limpiarBuffer();

    if (buscarProducto(p.codigo) != -1) {
        cout << "Ese codigo ya existe.\n";
        return;
    }

    cout << "Nombre: ";
    cin.getline(p.nombre, 31);

    cout << "Precio: ";
    cin >> p.precio;

    cout << "Stock: ";
    cin >> p.stock;
    limpiarBuffer();

    cout << "Categoria: ";
    cin.getline(p.categoria, 31);

    p.activo = true;

    fstream archivo(archivoNombre, ios::in | ios::out | ios::binary);
    if (!archivo) {
        archivo.open(archivoNombre, ios::out | ios::binary);
        archivo.close();
        archivo.open(archivoNombre, ios::in | ios::out | ios::binary);
    }

    archivo.seekp((p.codigo - 1) * sizeof(Producto));
    archivo.write((char*)&p, sizeof(Producto));
    archivo.close();

    cout << "Producto agregado.\n";
}

void mostrarActivos() {
    ifstream archivo(archivoNombre, ios::binary);
    if (!archivo) {
        cout << "No hay productos.\n";
        return;
    }

    Producto p;
    bool hay = false;
    while (archivo.read((char*)&p, sizeof(Producto))) {
        if (p.activo) {
            mostrarProducto(p);
            hay = true;
        }
    }

    if (!hay) cout << "No hay productos activos.\n";
    archivo.close();
}

void modificarProducto() {
    int codigo;
    cout << "Ingrese el código del producto a modificar: ";
    cin >> codigo;
    limpiarBuffer();

    long pos = buscarProducto(codigo);
    if (pos == -1) {
        cout << "Producto no encontrado.\n";
        return;
    }

    fstream archivo(archivoNombre, ios::in | ios::out | ios::binary);
    if (!archivo) {
        cout << "Error al abrir el archivo.\n";
        return;
    }

    Producto p;
    archivo.seekg(pos * sizeof(Producto));
    archivo.read((char*)&p, sizeof(Producto));

    if (!p.activo) {
        cout << "El producto está inactivo y no puede modificarse.\n";
        archivo.close();
        return;
    }

    cout << "\nDatos actuales del producto:\n";
    mostrarProducto(p);

    char entrada[31];

    cout << "Nuevo nombre (actual: " << p.nombre << "): ";
    cin.getline(entrada, 31);
    if (strlen(entrada) > 0) strcpy(p.nombre, entrada);

    float nuevoPrecio;
    cout << "Nuevo precio (actual: " << p.precio << "): ";
    cin >> nuevoPrecio;
    if (nuevoPrecio >= 0) p.precio = nuevoPrecio;

    int nuevoStock;
    cout << "Nuevo stock (actual: " << p.stock << "): ";
    cin >> nuevoStock;
    limpiarBuffer();
    if (nuevoStock >= 0) p.stock = nuevoStock;

    cout << "Nueva categoría (actual: " << p.categoria << "): ";
    cin.getline(entrada, 31);
    if (strlen(entrada) > 0) strcpy(p.categoria, entrada);

    archivo.seekp(pos * sizeof(Producto));
    archivo.write((char*)&p, sizeof(Producto));
    archivo.close();

    cout << "Producto modificado exitosamente.\n";
}

void eliminarProducto() {
    int codigo;
    cout << "Ingrese el código del producto a eliminar: ";
    cin >> codigo;
    limpiarBuffer();

    long pos = buscarProducto(codigo);
    if (pos == -1) {
        cout << "Producto no encontrado.\n";
        return;
    }

    fstream archivo(archivoNombre, ios::in | ios::out | ios::binary);
    if (!archivo) {
        cout << "Error al abrir el archivo.\n";
        return;
    }

    Producto p;
    archivo.seekg(pos * sizeof(Producto));
    archivo.read((char*)&p, sizeof(Producto));

    if (!p.activo) {
        cout << "El producto ya está inactivo.\n";
        archivo.close();
        return;
    }

    p.activo = false;

    archivo.seekp(pos * sizeof(Producto));
    archivo.write((char*)&p, sizeof(Producto));
    archivo.close();

    cout << "Producto eliminado (marcado como inactivo).\n";
}

void menu() {
    cout << "\n1. Agregar producto\n"
         << "2. Mostrar productos activos\n"
         << "3. Modificar producto\n"
         << "4. Eliminar producto\n"
         << "5. Salir\n"
         << "Elige una opcion: ";
}

int main() {
    int opcion;
    do {
        menu();
        cin >> opcion;
        limpiarBuffer();

        switch(opcion) {
            case 1: agregarProducto(); break;
            case 2: mostrarActivos(); break;
            case 3: modificarProducto(); break;
            case 4: eliminarProducto(); break;
            case 5: cout << "Saliendo...\n"; break;
            default: cout << "Opción invalida\n";
        }
    } while(opcion != 5);
    return 0;
}
