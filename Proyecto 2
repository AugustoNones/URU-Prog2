#include <iostream>
#include <fstream>
#include <cstring>

using namespace std;

struct Producto {
    int codigo;
    char nombre[31];
    float precio;
    int stock;
    char categoria[31];
    bool activo;
};

const char archivoNombre[] = "productos.dat";

void limpiarBuffer() {
    cin.clear();
    cin.ignore(10000, '\n');
}

long buscarProducto(int codigo) {
    ifstream archivo(archivoNombre, ios::binary);
    if (!archivo) return -1;

    Producto p;
    long pos = 0;
    while (archivo.read((char*)&p, sizeof(Producto))) {
        if (p.codigo == codigo) {
            archivo.close();
            return pos;
        }
        pos++;
    }
    archivo.close();
    return -1;
}

void agregarProducto() {
    Producto p;
    cout << "Codigo: ";
    cin >> p.codigo;
    limpiarBuffer();

    if (buscarProducto(p.codigo) != -1) {
        cout << "Ese codigo ya existe.\n";
        return;
    }

    cout << "Nombre: ";
    cin.getline(p.nombre, 31);

    cout << "Precio: ";
    cin >> p.precio;

    cout << "Stock: ";
    cin >> p.stock;
    limpiarBuffer();

    cout << "Categoria: ";
    cin.getline(p.categoria, 31);

    p.activo = true;

    fstream archivo(archivoNombre, ios::in | ios::out | ios::binary);
    if (!archivo) {
        // Si no existe el archivo, lo crea
        archivo.open(archivoNombre, ios::out | ios::binary);
        archivo.close();
        archivo.open(archivoNombre, ios::in | ios::out | ios::binary);
    }
